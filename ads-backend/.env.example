# Ads Garage API. Copy to .env for local development.
# Never commit .env. In production set these in your host's secret manager.

NODE_ENV=development
PORT=4000

# The web app's public URL. Used for CORS and for billing redirects.
APP_URL=http://localhost:3000
# Comma-separated list of allowed browser origins. Defaults to APP_URL. "*" is refused.
# CORS_ORIGINS=http://localhost:3000,https://app.example.com

# Set to true when running behind a reverse proxy or load balancer (so rate limits see real client IPs).
TRUST_PROXY=false

# --- Database -----------------------------------------------------------------
# Local development works with no database setup: it uses an SQLite file.
# SQLITE_PATH=data/ads-garage.sqlite
#
# For PostgreSQL (required in production), set DATABASE_URL. SQLite is refused when NODE_ENV=production.
# DATABASE_URL=postgres://ads_garage:ads_garage@localhost:5432/ads_garage
# DATABASE_SSL=false
#
# Auto-create tables from the entities. Convenient locally (default true for SQLite, false for Postgres).
# MUST be false in production: use migrations (see README).
# DATABASE_SYNCHRONIZE=false

# --- Auth ---------------------------------------------------------------------
# At least 32 random characters. Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production. In development a random one is used per start, so tokens reset on restart.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Rate limiting --------------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# --- API docs -------------------------------------------------------------------
# Swagger UI at /docs. On by default outside production.
# SWAGGER_ENABLED=true

# --- Billing (Stripe) -------------------------------------------------------------
# Leave empty to run without billing: checkout answers 503 and everyone stays on Starter.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring prices. A plan without a price cannot be purchased (checkout answers 501).
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ULTRA=price_...
