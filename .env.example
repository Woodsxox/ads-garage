# AdSense — replace with a real publisher ID before serving live ads.
# Live units render only on /, /gallery, /guide and /blog (see lib/ads/policy.ts). Never in the
# sandbox, studio, lessons, /garage or /build. Keep Auto ads OFF in the AdSense account.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_DISPLAY=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=0000000001
NEXT_PUBLIC_ADSENSE_SLOT_SIDE=0000000002

# Stripe — never hardcode secret keys. Paste values locally; do not commit .env
# TODO: create a Stripe Checkout price for $7.99 one-time (Single Export)
# TODO: create a Stripe Billing price for $24/mo (Garage Pro)
STRIPE_SECRET_KEY=
STRIPE_PRICE_EXPORT=
STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
